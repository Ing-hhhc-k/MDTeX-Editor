{
  "name": "mdtex-editor",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-main.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && node scripts/package.cjs",
    "test": "node --test tests/numbering.test.js tests/files.test.mjs tests/updates.test.js tests/portable.test.js",
    "test:desktop": "npm run build && node tests/desktop.cjs",
    "test:improvements": "npm run build && node tests/improvements.cjs",
    "test:v03": "npm run build && node tests/v03.cjs",
    "test:v04": "npm run build && node tests/v04.cjs",
    "test:v041": "npm run build && node tests/v041.cjs",
    "test:v042": "npm run build && node tests/v042.cjs",
    "test:v043": "npm run build && node tests/v043.cjs",
    "test:v05": "npm run build && node tests/v05.cjs",
    "test:update": "npm run dist && node tests/update-install.cjs",
    "test:numbering": "npm run build && node tests/numbering-ui.cjs",
    "test:formula": "npm run build && node tests/formula-caret.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.42.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/extension-list": "^3.34.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "esbuild": "^0.28.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.mdtex.editor",
    "productName": "MDTeX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
